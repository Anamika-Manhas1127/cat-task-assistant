# Copy this file to a new file named .env and add your own API keys.
# Never upload .env to GitHub.
GEMMA_API_KEY=PASTE_YOUR_API_KEY_HERE
# Set only to an exact Gemma model ID supported by Google's current API catalog.
# GEMMA_MODEL_ID=your-supported-gemma-model-id

# Sarvam AI API subscription key for Saaras V4 Speech-to-Text
SARVAM_API_KEY=PASTE_YOUR_SARVAM_API_KEY_HERE

# Fish Audio API for cute expressive cartoon cat text-to-speech (free tier: s2.1-pro-free)
# Sign up at https://fish.audio to get an API key and free development credits
FISH_AUDIO_API_KEY=PASTE_YOUR_FISH_AUDIO_API_KEY_HERE
# Optional: reference_id of a specific cute/cartoon cat voice from https://fish.audio
# FISH_AUDIO_VOICE_ID=your_voice_reference_id
# Optional: TTS model (defaults to s2.1-pro-free for the free developer tier)
# FISH_AUDIO_MODEL=s2.1-pro-free

